# SmartArchiver SSH Server — sshd 配置
# 专为 sync 模式设计：允许 root 登录、支持密钥和密码两种认证

# 网络
Port 22
AddressFamily any
ListenAddress 0.0.0.0

# 认证
PermitRootLogin yes
PasswordAuthentication yes
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

# 禁用不安全的认证方式
ChallengeResponseAuthentication no
# KerberosAuthentication no
# GSSAPIAuthentication no
HostbasedAuthentication no

# 严格模式：关闭，允许挂载的 .ssh 目录权限不被 sshd 拒绝
StrictModes no

# SFTP 子系统（rclone SFTP 模式依赖）
Subsystem sftp internal-sftp

# 日志输出到 stdout/stderr（方便 docker logs 查看）
LogLevel INFO

# 性能与连接
# UsePAM no
TCPKeepAlive yes
ClientAliveInterval 60
ClientAliveCountMax 3

# 禁用不需要的功能
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*

# 主机密钥（由 entrypoint.sh 在容器启动时自动生成）
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ed25519_key
